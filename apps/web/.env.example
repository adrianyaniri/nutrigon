# ==============================================================================
# Nutrigon Web Frontend - Environment Variables Configuration
# ==============================================================================

# Backend API URL (NestJS)
# - Set to "http://localhost:3000" to connect to the real NestJS API & PostgreSQL database.
# - Leave empty or omit only for local development in standalone mock mode.
# - Production builds require an HTTPS origin, e.g. https://api.nutrigon.ar.
VITE_API_URL=http://localhost:3000

# Application Configuration
VITE_APP_NAME=Nutrigon Dietética
VITE_APP_ENV=development

# Supabase Configuration (Optional / Legacy)
# Only required if connecting directly to Supabase client instead of NestJS API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-anon-key-placeholder

