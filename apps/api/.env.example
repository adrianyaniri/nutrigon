# ==============================================================================
# Nutrigon API - Environment Variables Configuration
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,https://nutrigon.pages.dev

# PostgreSQL Connection URL
# Local Docker Compose defaults: postgresql://postgres:postgres@localhost:5432/nutrigon
# Internal Docker network (between containers): postgresql://postgres:postgres@postgres:5432/nutrigon
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nutrigon

# JWT Authentication
# In production, use a secure secret with at least 64 characters (e.g. openssl rand -base64 48)
JWT_SECRET=nutrigon_default_development_secret_key_12345
JWT_EXPIRES_IN=8h

# Cloudflare R2 Media Storage (S3-compatible)
# Optional in local dev: if omitted, the API will serve mock presigned upload URLs
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nutrigon-media
R2_PUBLIC_URL=https://media.nutrigon.com

