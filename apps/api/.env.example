# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (Docker local or Railway)
DATABASE_URL=postgresql://nutrigon:nutrigon_dev_password@localhost:5432/nutrigon_db

# JWT Authentication
JWT_SECRET=nutrigon-local-dev-secret-change-in-production-min-64-chars-long
JWT_EXPIRES_IN=8h

# Cloudflare R2 Storage (S3 Compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nutrigon-media
R2_PUBLIC_URL=https://media.nutrigon.com
