# ==============================================================================
# Nutrigon API - Environment Variables Configuration
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed CORS origins
# Production: https://www.nutrigon.ar,https://nutrigon.ar,https://nutrigon.pages.dev
CORS_ORIGINS=http://localhost:5173,https://nutrigon.pages.dev

# PostgreSQL Connection URL
# Required in production. The local value below is only for development.
# Local Docker Compose defaults: postgresql://postgres:postgres@localhost:5432/nutrigon
# Internal Docker network (between containers): postgresql://postgres:postgres@postgres:5432/nutrigon
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nutrigon

# JWT Authentication
# Required in production: use a unique secret with at least 64 characters (e.g. openssl rand -base64 48).
# Leave unset only for local development, where a non-production fallback is used.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Initial General Administrator
# Required only when executing the production seed for the first time. The seed never changes an existing user's credentials.
# Do not commit real values.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Cloudflare R2 Media Storage (S3-compatible)
# Optional in local dev: if omitted, the API will serve mock presigned upload URLs
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nutrigon-media
R2_PUBLIC_URL=https://media.nutrigon.com

