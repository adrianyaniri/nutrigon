  token: {{token}}
}

body:json {
  {
    "categoryId": "{{categoryId}}",
    "name": "Nuez Pecan Tostada",
    "saleUnit": "WEIGHT",
    "description": "Nuez de producción nacional primera calidad",
    "imageUrls": []
  }
}
