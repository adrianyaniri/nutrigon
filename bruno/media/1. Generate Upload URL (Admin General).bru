meta {
  name: 1. Generate Upload URL (Admin General)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/media/upload-url
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "fileName": "almendras-nonpareil.webp",
    "contentType": "image/webp",
    "folder": "products"
  }
}

vars:post-response {
  uploadUrl: res.body.uploadUrl
  publicUrl: res.body.publicUrl
  mediaKey: res.body.key
}
