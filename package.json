{
  "name": "nutrigon",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:seed": "pnpm --filter @nutrigon/api db:seed",
    "db:seed:branches": "pnpm --filter @nutrigon/api db:seed:branches",
    "db:seed:branches:prod": "pnpm --filter @nutrigon/api db:seed:branches:prod",
    "db:import:products": "pnpm --filter @nutrigon/api db:import:products",
    "db:import:products:prod": "pnpm --filter @nutrigon/api db:import:products:prod",
    "db:import:branch-prices": "pnpm --filter @nutrigon/api db:import:branch-prices",
    "db:import:branch-prices:prod": "pnpm --filter @nutrigon/api db:import:branch-prices:prod",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.5.1",
    "turbo": "^2.5.0"
  }
}
